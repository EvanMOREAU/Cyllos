{% extends 'base.html.twig' %}

{% block title %}Nouveau formulaire HelloAsso — {{ client.name }} - Cyllos{% endblock %}
{% block content_width %}content--narrow{% endblock %}

{% block breadcrumb %}<div class="topbar__crumb"><a href="{{ path('admin_client_list') }}">Clients</a> / <a href="{{ path('admin_client_show', {id: client.id}) }}">{{ client.name }}</a> / Nouveau formulaire HelloAsso</div>{% endblock %}
{% block page_title %}Nouveau formulaire HelloAsso{% endblock %}

{% block body %}
    <div class="card">
        {{ form_start(form) }}
            <div class="field-group">
                <h2 style="font-size:1rem;margin-bottom:1.1rem;">Identifiants et paramètres HelloAsso</h2>
                {% include 'admin/client/_helloasso_label_fields.html.twig' with {form: form} only %}
                <div class="form-grid">
                    {{ form_row(form.apiUrl) }}
                    {{ form_row(form.helloAssoClientId) }}
                    {{ form_row(form.clientSecret) }}
                    {{ form_row(form.organizationSlug) }}
                    {{ form_row(form.formType) }}
                    {{ form_row(form.formSlug) }}
                    {{ form_row(form.maxAmount) }}
                    {{ form_row(form.fetchNbDays) }}
                    {{ form_row(form.extraMailFieldName) }}
                </div>
            </div>
            <div class="form-footer">
                <a class="btn btn--ghost" href="{{ path('admin_client_show', {id: client.id}) }}">Annuler</a>
                <button class="btn" type="submit">Ajouter le formulaire</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
