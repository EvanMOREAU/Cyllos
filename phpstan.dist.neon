includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - src
        - tests
    excludePaths:
        analyseAndScan:
            - src/Kernel.php
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/phpstan-doctrine-object-manager.php
    bootstrapFiles:
        - vendor/autoload.php
